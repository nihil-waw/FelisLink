<?xml version="1.0" encoding="utf-8"?>
<!--
  FelisLink settings page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F51C1C1E"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/back_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/settings_button_bg"
        android:clickable="true"
        android:contentDescription="@string/settings_back"
        android:focusable="true"
        android:gravity="center"
        android:text="‹"
        android:textColor="@color/onOverlaySurface"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/settings_title"
        style="@style/H3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/settings_title"
        android:textColor="?colorPrimary" />
  </LinearLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/settings_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
  </ScrollView>
</LinearLayout>