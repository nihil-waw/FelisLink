  <string name="rotation_system">自动（传感器）</string>
  <string name="rotation_landscape">横屏</string>
  <string name="rotation_portrait">竖屏</string>

  <string name="settings_resolution">采集分辨率</string>
  <string name="settings_resolution_summary">首选的 UVC 分辨率。若不可用，将回退到采集卡支持的最接近格式。</string>
  <string name="resolution_auto">自动（匹配屏幕）</string>
  <string name="resolution_fhd">1920 × 1080</string>
  <string name="resolution_hd">1280 × 720</string>
  <string name="resolution_sd">640 × 480</string>

  <string name="settings_color_format">色彩格式</string>
  <string name="settings_color_format_summary">首选的 UVC 像素格式。MJPEG 占用的 USB 带宽更少。</string>
  <string name="color_format_auto">自动</string>
  <string name="color_format_mjpeg">MJPEG</string>
  <string name="color_format_yuyv">YUYV</string>
  <string name="color_format_nv12">NV12</string>

  <string name="settings_hud">统计信息浮层（HUD）</string>
  <string name="settings_hud_summary">在画面上显示帧率、格式和耗时。关闭后画面更干净。</string>

  <string name="settings_keep_screen_on">保持屏幕常亮</string>
  <string name="settings_keep_screen_on_summary">FelisLink 在前台运行时阻止屏幕休眠。</string>

  <string name="settings_immersive">沉浸式全屏</string>
  <string name="settings_immersive_summary">隐藏系统栏，让画面铺满整块屏幕。</string>

  <string name="settings_on">开</string>
  <string name="settings_off">关</string>
  <string name="settings_value_format">%1$s ›</string>

  <string name="settings_about_version">FelisLink %1$s</string>
  <string name="settings_about_note">采集引擎基于 Meta usb-video（Apache-2.0）。旋转、HUD、屏幕常亮和沉浸式设置会立即生效；分辨率和色彩格式将在下次连接采集卡时应用。</string>


  <string name="settings_section_advanced">高级采集</string>
  <string name="settings_fps_cap">帧率上限</string>
  <string name="settings_fps_cap_summary">采集帧率的上限。很多采集卡标称 60 fps，但在 USB 2.0 上跑不满。</string>
  <string name="settings_fps_cap_unlimited">不限制</string>
  <string name="settings_fps_cap_value">%1$d fps</string>
  <string name="settings_compression_quality">压缩质量</string>
  <string name="settings_compression_quality_note">不可调：libuvc 没有开放 UVC Compression Control，MJPEG 画质由采集卡固件和所选格式决定。这里如实说明，不做假滑块。</string>
  <string name="settings_auto_downgrade">自动降级</string>
  <string name="settings_auto_downgrade_summary">画面掉帧时自动降一档格式。卡顿检测尚未接入，当前版本只保存这个开关。</string>
  <string name="settings_apply_timing">生效时机</string>
  <string name="settings_apply_timing_summary">分辨率、帧率上限、色彩格式在下次接入采集卡时生效；连接后仍可在状态页手动改格式。</string>

