  <string name="settings_language">语言</string>
  <string name="settings_language_summary">跟随系统语言，或为 FelisLink 指定一种语言。</string>
  <string name="language_system">跟随系统</string>
  <string name="language_chinese">简体中文</string>

  <string name="settings_rotation">屏幕旋转</string>
