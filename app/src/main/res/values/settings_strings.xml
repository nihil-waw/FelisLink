  <string name="settings_hud">Stats overlay (HUD)</string>
  <string name="settings_hud_summary">Shows fps, format and timing over the video. Off means a clean picture.</string>

  <string name="settings_keep_screen_on">Keep screen on</string>
  <string name="settings_keep_screen_on_summary">Prevents the screen from sleeping while FelisLink is in the foreground.</string>

  <string name="settings_immersive">Immersive fullscreen</string>
  <string name="settings_immersive_summary">Hides the system bars so the picture fills the panel.</string>

  <string name="settings_on">On</string>
  <string name="settings_off">Off</string>
  <string name="settings_value_format">%1$s ›</string>

  <string name="settings_about_version">FelisLink %1$s</string>
  <string name="settings_about_note">Capture engine based on Meta usb-video (Apache-2.0). Rotation, HUD, screen-on and immersive take effect right away; resolution and color format apply the next time a capture card connects.</string>


  <string name="settings_section_advanced">Advanced capture</string>
  <string name="settings_fps_cap">Frame rate cap</string>
  <string name="settings_fps_cap_summary">Upper bound for the capture frame rate. Cards often advertise 60 fps but cannot sustain it over USB 2.0.</string>
  <string name="settings_fps_cap_unlimited">No limit</string>
  <string name="settings_fps_cap_value">%1$d fps</string>
  <string name="settings_compression_quality">Compression quality</string>
  <string name="settings_compression_quality_note">Not adjustable: libuvc exposes no UVC Compression Control, so MJPEG quality is fixed by the card firmware and the format you pick. Disabled on purpose instead of faking a slider.</string>
  <string name="settings_auto_downgrade">Auto downgrade</string>
  <string name="settings_auto_downgrade_summary">Drop one format step when frames stall. The stutter detector is not wired yet; this build only stores the preference.</string>
  <string name="settings_apply_timing">When it applies</string>
  <string name="settings_apply_timing_summary">Resolution, frame-rate cap and color format are used the next time a capture card connects. The status screen can still override the format live.</string>

  <string name="capture_profile_dialog_title">Capture card profile</string>
  <string name="capture_profile_device">Device: %1$s</string>
  <string name="capture_profile_chipset">Chipset: %1$s (label only)</string>
  <string name="capture_profile_link_usb3">Link: USB 3.0</string>
  <string name="capture_profile_link_usb2">Link: USB 2.0 (480 Mbps)</string>
  <string name="capture_profile_link_unknown">Link: unknown, treating it as USB 2.0</string>
  <string name="capture_profile_audio_yes">Audio: detected, will be captured</string>
  <string name="capture_profile_audio_no">Audio: this card exposes no UAC, video only</string>
  <string name="capture_profile_selected">Format: %1$s</string>
  <string name="capture_profile_reason_usb3">USB 3.0 link, so uncompressed formats are preferred to save CPU.</string>
  <string name="capture_profile_reason_usb2">USB 2.0 link, so we stay on compressed MJPEG to avoid dropped frames.</string>
  <string name="capture_profile_reason_user">Chosen from your pixel-format preference.</string>
  <string name="capture_profile_fallbacks">Fallback if it stutters: %1$s</string>
  <string name="capture_profile_note">Compressed-image quality comes from the card firmware; libuvc has no compression control.</string>
  <string name="capture_profile_apply">Use this profile</string>
  <string name="capture_profile_manual">Choose manually</string>


