<resources xmlns:tools="http://schemas.android.com/tools">

  <!-- application theme. -->
  <style name="Theme.UsbVideo" parent="Theme.AppCompat.DayNight.NoActionBar">
  </style>

  <!-- Full screen theme. -->
  <style name="Theme.UsbVideo.Fullscreen">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="colorPrimary">#90CAF9</item>
    <item name="colorOnPrimary">#1C1C1E</item>
    <item name="colorError">#EF5350</item>
    <item name="android:colorBackground">#1C1C1E</item>
    <item name="android:textColorPrimary">#FFFFFF</item>
    <item name="android:textColorSecondary">#B0BEC5</item>
    <item name="colorSecondary">#B0BEC5</item>
    <item name="cardBackgroundColor">#2C2C2E</item>
  </style>


  <!-- Light theme: Material-like surfaces with dark text. -->
  <style name="Theme.UsbVideo.Light">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="colorPrimary">#1A73E8</item>
    <item name="colorOnPrimary">#FFFFFF</item>
    <item name="colorError">#D93025</item>
    <item name="android:colorBackground">#F8FAFC</item>
    <item name="android:textColorPrimary">#202124</item>
    <item name="android:textColorSecondary">#5F6368</item>
    <item name="colorSecondary">#5F6368</item>
    <item name="cardBackgroundColor">#FFFFFF</item>
  </style>

  <!-- Google-style theme: Material blue accent on soft gray surfaces. -->
  <style name="Theme.UsbVideo.Google">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="colorPrimary">#4285F4</item>
    <item name="colorOnPrimary">#FFFFFF</item>
    <item name="colorError">#EA4335</item>
    <item name="android:colorBackground">#F1F3F4</item>
    <item name="android:textColorPrimary">#202124</item>
    <item name="android:textColorSecondary">#5F6368</item>
    <item name="colorSecondary">#34A853</item>
    <item name="cardBackgroundColor">#FFFFFF</item>
  </style>

  <!-- True black theme for OLED secondary screens. -->
  <style name="Theme.UsbVideo.Black">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="colorPrimary">#8AB4F8</item>
    <item name="colorOnPrimary">#000000</item>
    <item name="colorError">#F28B82</item>
    <item name="android:colorBackground">#000000</item>
    <item name="android:textColorPrimary">#FFFFFF</item>
    <item name="android:textColorSecondary">#B0BEC5</item>
    <item name="colorSecondary">#B0BEC5</item>
    <item name="cardBackgroundColor">#101010</item>
  </style>

  <!-- Translucent so the capture activity behind keeps its surface (and the stream) alive. -->
  <style name="Theme.UsbVideo.Settings" parent="@style/Theme.UsbVideo.Fullscreen">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:backgroundDimAmount">0.6</item>
  </style>

  <style name="FelisLinkDialog" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:colorAccent">@color/felislink_accent</item>
    <item name="android:colorBackground">@color/felislink_chip_off</item>
    <item name="android:textColorPrimary">@android:color/white</item>
    <item name="android:textColorSecondary">@color/felislink_text_secondary</item>
  </style>

  <style name="status_title_text">
    <item name="android:textColor">?colorPrimary</item>
    <item name="android:textSize">14sp</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textStyle">bold</item>
    <item name="android:lineHeight">20sp</item>
  </style>

  <style name="status_subtitle_text">
    <item name="android:textSize">11sp</item>
    <item name="android:textColor">?colorSecondary</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:lineHeight">16sp</item>
  </style>

  <style name="status_subtitle_warn">
    <item name="android:textSize">11sp</item>
    <item name="android:textColor">?colorError</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:lineHeight">16sp</item>
  </style>

  <style name="status_subtitle_error">
    <item name="android:textSize">11sp</item>
    <item name="android:textColor">?colorError</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:lineHeight">16sp</item>
  </style>

  <style name="Body1" parent="TextAppearance.AppCompat.Body1"/>
  <style name="H3" parent="TextAppearance.AppCompat.Headline"/>

</resources>